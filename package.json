{
  "name": "weekly-scorecard",
  "version": "0.1.0",
  "description": "Weekly GitHub activity scorecard powered by Claude AI, hosted on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
